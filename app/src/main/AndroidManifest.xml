<!-- Nothing OS Digital Dot Clock Widget -->
        <receiver
            android:name="com.example.ui.components.NothingDigitalClockWidgetProvider"
            android:label="Nothing Digital Clock"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/nothing_digital_clock_info" />
        </receiver>

        <!-- Nothing OS Analog Clock Widget -->
        <receiver
