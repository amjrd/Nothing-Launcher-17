<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="12dp"
    android:background="@drawable/bg_nothing_widget">

    <AnalogClock
        android:id="@+id/widget_analog_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dial="@android:drawable/clock_dial"
        android:hand_hour="@android:drawable/clock_hand_hour"
        android:hand_minute="@android:drawable/clock_hand_minute" />
</FrameLayout>
